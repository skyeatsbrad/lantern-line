{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "The Lantern Line v0.8 asset manifest",
  "type": "object",
  "required": [
    "schema_version",
    "pipeline_version",
    "toolchain",
    "categories"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "pipeline_version": {
      "type": "string",
      "minLength": 1
    },
    "toolchain": {
      "type": "object",
      "required": [
        "blender_pin",
        "godot_version"
      ],
      "properties": {
        "blender_pin": {
          "type": "string"
        },
        "godot_version": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subjects"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "subjects": {
            "type": "array"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
